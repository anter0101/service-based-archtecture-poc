# Shared across all apps — must be identical so shell/dashboard can decode the auth cookie
AUTH_SECRET=change-me-to-a-long-random-string

# Auth app is the cookie issuer
AUTH_URL=http://localhost:3002
NEXTAUTH_URL=http://localhost:3002

# NestJS gateway (not identity-service directly)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cross-app origins
NEXT_PUBLIC_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_SHELL_URL=http://localhost:3003
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3004

# For subdomain deploy later (e.g. .example.com). Leave unset for localhost POC.
# AUTH_COOKIE_DOMAIN=.example.com
