{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Service-Based Architecture Gateway",
    "description": "V1 POC collection. Hit the NestJS Gateway (port 3000).\n\nFlow:\n1. Register or Login (public) — saves `accessToken`\n2. Call protected user routes with Bearer auth\n\nIdentity is not the public entry point. The gateway rewrites `/api/identity/*` to the identity service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "email",
      "value": "ada@example.com"
    },
    {
      "key": "password",
      "value": "s3cretPass"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Public. Served by the gateway, not proxied."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('service is gateway', () => {",
                  "  pm.expect(pm.response.json().service).to.eql('gateway');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth (public)",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/identity/auth/register",
            "description": "Public. Proxied to Identity `POST /auth/register`. Saves `accessToken` and `userId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created or conflict', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('returns JWT', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "  pm.test('does not return passwordHash', () => {",
                  "    pm.expect(JSON.stringify(body)).to.not.include('passwordHash');",
                  "    pm.expect(JSON.stringify(body)).to.not.include('password');",
                  "  });",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  if (body.user && body.user.id) {",
                  "    pm.collectionVariables.set('userId', String(body.user.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/identity/auth/login",
            "description": "Public. Proxied to Identity `POST /auth/login`. Saves `accessToken`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns JWT', () => pm.expect(body.accessToken).to.be.a('string'));",
                  "pm.test('does not return passwordHash', () => {",
                  "  pm.expect(JSON.stringify(body)).to.not.include('passwordHash');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.user && body.user.id) {",
                  "  pm.collectionVariables.set('userId', String(body.user.id));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users (protected)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/identity/users/me",
            "description": "Requires Bearer JWT. Proxied to Identity `GET /users/me`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns the current user', () => {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('email');",
                  "});",
                  "pm.test('does not return passwordHash', () => {",
                  "  pm.expect(body).to.not.have.property('passwordHash');",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});",
                  "if (body.id) pm.collectionVariables.set('userId', String(body.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me without JWT",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/identity/users/me",
            "description": "Gateway must return 401 and must not proxy this to Identity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/identity/users?page=1&pageSize=10&sortField=id&sortOrder=ASC",
            "description": "Requires Bearer JWT. Proxied to Identity `GET /users`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/identity/users/{{userId}}",
            "description": "Requires Bearer JWT. Proxied to Identity `GET /users/:id`."
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grace Hopper\",\n  \"email\": \"grace@example.com\",\n  \"password\": \"s3cretPass\"\n}"
            },
            "url": "{{baseUrl}}/api/identity/users",
            "description": "Requires Bearer JWT. Proxied to Identity `POST /users`."
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\"\n}"
            },
            "url": "{{baseUrl}}/api/identity/users/{{userId}}",
            "description": "Requires Bearer JWT. Proxied to Identity `PATCH /users/:id`."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/identity/users/{{userId}}",
            "description": "Requires Bearer JWT. Proxied to Identity `DELETE /users/:id`."
          }
        }
      ]
    }
  ]
}
